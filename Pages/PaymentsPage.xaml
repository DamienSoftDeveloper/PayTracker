<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:PayTracker.Models"
             x:Class="PayTracker.Pages.PaymentsPage"
             Title="Payments">
    
    <Grid Padding="16"
          RowDefinitions="Auto,*"
          RowSpacing="12">

        <!-- Main list -->
        <Button x:Name="AddButton"
                Grid.Row="0"
                Text="Add payment"
                Clicked="OnAddClicked" />

        <CollectionView x:Name="PaymentsList"
                        Grid.Row="1"
                        SelectionMode="None">

            <CollectionView.EmptyView>
                <Label Text="No payments yet. Tap Add payment."
                       HorizontalTextAlignment="Center"
                       Margin="0,24" />
            </CollectionView.EmptyView>

            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Payment">
                    <Border Padding="12"
                            Margin="0,0,0,12"
                            StrokeThickness="1">

                        <VerticalStackLayout Spacing="6">

                            <Label Text="{Binding Name}"
                                   FontSize="20"
                                   FontAttributes="Bold">
                                <Label.Triggers>
                                    <DataTrigger TargetType="Label"
                                                 Binding="{Binding IsPaid}"
                                                 Value="True">
                                        <Setter Property="TextDecorations"
                                                Value="Strikethrough" />
                                    </DataTrigger>
                                </Label.Triggers>
                            </Label>

                            <Label Text="{Binding AmountText}"
                                   FontSize="18" />

                            <Label Text="{Binding DueText}" />

                            <Label Text="{Binding StatusText}" />

                            <HorizontalStackLayout Spacing="8">
                                <Button Text="Edit"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnEditClicked" />

                                <Button Text="Delete"
                                        CommandParameter="{Binding .}"
                                        Clicked="OnDeleteClicked" />
                            </HorizontalStackLayout>

                            <Button Text="{Binding PayButtonText}"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnMarkPaidClicked" />

                            <Button Text="Mark unpaid"
                                    IsVisible="{Binding IsPaid}"
                                    CommandParameter="{Binding .}"
                                    Clicked="OnMarkUnpaidClicked" />

                        </VerticalStackLayout>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Form shown when adding, editing, or recording a payment -->
        <ScrollView x:Name="EditorPanel"
                    Grid.Row="0"
                    Grid.RowSpan="2"
                    IsVisible="False">

            <VerticalStackLayout Spacing="12">

                <Label x:Name="EditorTitle"
                       FontSize="24"
                       FontAttributes="Bold" />

                <VerticalStackLayout x:Name="DetailsFields"
                                     Spacing="8">

                    <Label Text="Payment name" />
                    <Entry x:Name="NameEntry"
                           Placeholder="For example, phone bill" />

                    <Label Text="Amount (£)" />
                    <Entry x:Name="AmountEntry"
                           Keyboard="Numeric"
                           Placeholder="For example, 25.00" />

                    <Label Text="Due date" />
                    <DatePicker x:Name="DueDatePicker"
                                Format="dd MMM yyyy" />

                </VerticalStackLayout>

                <VerticalStackLayout x:Name="PaidFields"
                                     Spacing="8"
                                     IsVisible="False">

                    <Label Text="Date you paid" />
                    <DatePicker x:Name="PaidDatePicker"
                                Format="dd MMM yyyy" />

                </VerticalStackLayout>

                <Label x:Name="ErrorLabel"
                       TextColor="Red"
                       IsVisible="False" />

                <Button Text="Save"
                        Clicked="OnSaveClicked" />

                <Button Text="Cancel"
                        Clicked="OnCancelClicked" />

            </VerticalStackLayout>
        </ScrollView>

    </Grid>
</ContentPage>
    