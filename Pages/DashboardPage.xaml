<?xml version="1.0" encoding="utf-8" ?>
<ContentPage
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:PayTracker.Models"
    x:Class="PayTracker.Pages.DashboardPage"
    Title="Dashboard">

    <ScrollView>
        <VerticalStackLayout Padding="20" Spacing="18">

            <Label Text="Welcome to PayTracker"
                   FontSize="28"
                   FontAttributes="Bold" />

            <Label Text="An overview of all your saved payments."
                   FontSize="15"
                   TextColor="{AppThemeBinding Light=#475569,
                                               Dark=#CBD5E1}" />

            <Button x:Name="RefreshButton"
                    Text="Refresh dashboard"
                    Clicked="OnRefreshClicked" />

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsRunning="False"
                               IsVisible="False"
                               HorizontalOptions="Center" />

            <Label x:Name="ErrorLabel"
                   IsVisible="False"
                   TextColor="{AppThemeBinding Light=#B91C1C,
                                               Dark=#FCA5A5}" />

            <!-- Summary cards -->
            <Grid ColumnDefinitions="*,*"
                  RowDefinitions="Auto,Auto"
                  ColumnSpacing="12"
                  RowSpacing="12">

                <Border Grid.Row="0"
                        Grid.Column="0"
                        Padding="16"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Total scheduled"
                               FontSize="14" />

                        <Label x:Name="TotalLabel"
                               Text="--"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <Label x:Name="PaymentCountLabel"
                               Text="Loading payments"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="0"
                        Grid.Column="1"
                        Padding="16"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Paid"
                               FontSize="14" />

                        <Label x:Name="PaidLabel"
                               Text="--"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <Label x:Name="PaidCountLabel"
                               Text="--"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="0"
                        Padding="16"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Remaining"
                               FontSize="14" />

                        <Label x:Name="RemainingLabel"
                               Text="--"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <Label x:Name="UnpaidCountLabel"
                               Text="--"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

                <Border Grid.Row="1"
                        Grid.Column="1"
                        Padding="16"
                        Stroke="#CBD5E1"
                        StrokeShape="RoundRectangle 12">

                    <VerticalStackLayout Spacing="8">
                        <Label Text="Overdue"
                               FontSize="14" />

                        <Label x:Name="OverdueLabel"
                               Text="--"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <Label x:Name="OverdueCountLabel"
                               Text="--"
                               FontSize="12" />
                    </VerticalStackLayout>
                </Border>

            </Grid>

            <Label Text="Next unpaid payments"
                   FontSize="22"
                   FontAttributes="Bold"
                   Margin="0,12,0,0" />

            <Label Text="Up to five, earliest due date first. Includes overdue payments."
                   FontSize="13"
                   TextColor="{AppThemeBinding Light=#475569,
                                               Dark=#CBD5E1}" />

            <Label x:Name="EmptyPaymentsLabel"
                   Text="You have no unpaid payments."
                   IsVisible="False"
                   HorizontalTextAlignment="Center"
                   Margin="0,12" />

            <VerticalStackLayout x:Name="UpcomingPaymentsLayout"
                                 Spacing="12">

                <BindableLayout.ItemTemplate>
                    <DataTemplate x:DataType="models:Payment">

                        <Border Padding="16"
                                Stroke="#CBD5E1"
                                StrokeShape="RoundRectangle 12">

                            <VerticalStackLayout Spacing="6">

                                <Label Text="{Binding Name}"
                                       FontSize="18"
                                       FontAttributes="Bold" />

                                <Label Text="{Binding AmountText}"
                                       FontSize="17" />

                                <Label Text="{Binding DueText}"
                                       FontSize="14" />

                            </VerticalStackLayout>
                        </Border>

                    </DataTemplate>
                </BindableLayout.ItemTemplate>

            </VerticalStackLayout>

            <Label x:Name="UpdatedLabel"
                   Text=""
                   FontSize="12"
                   TextColor="{AppThemeBinding Light=#475569,
                                               Dark=#CBD5E1}" />

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>